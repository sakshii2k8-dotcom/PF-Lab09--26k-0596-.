
#include <stdio.h>

// Function declarations
void wrongSwap(int a, int b);
void repairCounters(int *a, int *b);
void analyzeOccupancy(int days[], int size,
                      int *total, int *highest, int *lowest);

int main()
{
    int wardA = 40;
    int wardB = 25;

    int juniorA = 60;
    int juniorB = 30;

    int occupancy[7] = {20, 25, 18, 30, 22, 28, 15};

    int total, highest, lowest;

    printf("HOSPITAL WARD REPAIR UTILITY\n");

    // Ordinary parameter attempt
    printf("\nBefore ordinary swap:\n");
    printf("juniorA = %d, Address = %p\n",
           juniorA, (void *)&juniorA);
    printf("juniorB = %d, Address = %p\n",
           juniorB, (void *)&juniorB);

    wrongSwap(juniorA, juniorB);

    printf("\nAfter ordinary swap:\n");
    printf("juniorA = %d\n", juniorA);
    printf("juniorB = %d\n", juniorB);

    // Correct swap using pointers
    printf("\nBefore pointer swap:\n");
    printf("wardA = %d, Address = %p\n",
           wardA, (void *)&wardA);
    printf("wardB = %d, Address = %p\n",
           wardB, (void *)&wardB);

    repairCounters(&wardA, &wardB);

    printf("\nAfter pointer swap:\n");
    printf("wardA = %d\n", wardA);
    printf("wardB = %d\n", wardB);

    // Analyze occupancy
    analyzeOccupancy(occupancy, 7,
                     &total, &highest, &lowest);

    printf("\nWeekly Occupancy Analysis:\n");
    printf("Total = %d\n", total);
    printf("Highest = %d\n", highest);
    printf("Lowest = %d\n", lowest);

    return 0;
}

// Ordinary parameters: only copies are swapped
void wrongSwap(int a, int b)
{
    int temp;

    printf("\nInside wrongSwap:\n");
    printf("Address of a = %p\n", (void *)&a);
    printf("Address of b = %p\n", (void *)&b);

    temp = a;
    a = b;
    b = temp;
}

// Pointer parameters: original variables are swapped
void repairCounters(int *a, int *b)
{
    int temp;

    printf("\nInside repairCounters:\n");
    printf("Address stored in a = %p\n", (void *)a);
    printf("Address stored in b = %p\n", (void *)b);

    temp = *a;
    *a = *b;
    *b = temp;
}

// Calculate three results in one function
void analyzeOccupancy(int days[], int size,
                      int *total, int *highest, int *lowest)
{
    int i;

    *total = 0;
    *highest = days[0];
    *lowest = days[0];

    printf("\nInside analyzeOccupancy:\n");
    printf("Address of first array element = %p\n",
           (void *)&days[0]);
    printf("Address of total result = %p\n", (void *)total);

    for (i = 0; i < size; i++)
    {
        *total = *total + days[i];

        if (days[i] > *highest)
        {
            *highest = days[i];
        }

        if (days[i] < *lowest)
        {
            *lowest = days[i];
        }
    }
}

