
#include <stdio.h>


void printValue(void *data, char type);

double add(int a, int b, int *valid);
double subtract(int a, int b, int *valid);
double multiply(int a, int b, int *valid);
double divide(int a, int b, int *valid);

double calculate(int a, int b,
                 double (*operation)(int, int, int *),
                 int *valid);

int main()
{
    // Generic printing variables
    int number = 25;
    float decimal = 12.567;
    char character = 'A';

    int num1, num2, choice;
    int valid = 1;

    double result;

    
    double (*operations[4])(int, int, int *) =
    {
        add,
        subtract,
        multiply,
        divide
    };

    printf("GENERIC DATA PRINTER\n\n");

    printValue(&number, 'i');
    printValue(&decimal, 'f');
    printValue(&character, 'c');

    // Calculator
    printf("\nSMART CALCULATOR\n");

    printf("Enter first integer: ");
    scanf("%d", &num1);

    printf("Enter second integer: ");
    scanf("%d", &num2);

    printf("\n1. Addition\n");
    printf("2. Subtraction\n");
    printf("3. Multiplication\n");
    printf("4. Division\n");

    printf("Choose operation: ");
    scanf("%d", &choice);

    if (choice < 1 || choice > 4)
    {
        printf("Invalid menu choice!\n");
        return 1;
    }

    result = calculate(num1, num2,
                       operations[choice - 1], &valid);

    if (valid == 1)
    {
        printf("Result = %.2f\n", result);
    }
    else
    {
        printf("Error! Division by zero is not allowed.\n");
    }

    return 0;
}
void printValue(void *data, char type)
{
    if (type == 'i')
    {
        printf("Integer: %d\n", *(int *)data);
    }
    else if (type == 'f')
    {
        printf("Float: %.2f\n", *(float *)data);
    }
    else if (type == 'c')
    {
        printf("Character: %c\n", *(char *)data);
    }
    else
    {
        printf("Invalid data type!\n");
    }
}

double add(int a, int b, int *valid)
{
    *valid = 1;
    return a + b;
}


double subtract(int a, int b, int *valid)
{
    *valid = 1;
    return a - b;
}


double multiply(int a, int b, int *valid)
{
    *valid = 1;
    return a * b;
}


double divide(int a, int b, int *valid)
{
    if (b == 0)
    {
        *valid = 0;
        return 0;
    }

    *valid = 1;
    return (double)a / b;
}

double calculate(int a, int b,
                 double (*operation)(int, int, int *),
                 int *valid)
{
    return operation(a, b, valid);
}

