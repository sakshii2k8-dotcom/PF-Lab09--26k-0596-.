
#include <stdio.h>

// Function declarations
void displayHall1(int (*ptr)[4], int rows);
int countVacantHall1(int (*ptr)[4], int rows);

void displayHall2(int *hall[], int sizes[], int rows);
int countVacantHall2(int *hall[], int sizes[], int rows);

void bookSeat(int *hall[], int sizes[], int rows);

int main()
{
    // Hall 1: 3 rows and 4 seats
    int hall1[3][4] = {
        {1, 0, 1, 0},
        {0, 1, 0, 0},
        {1, 0, 0, 1}
    };

    // Hall 2: Unequal row sizes
    int front[3] = {1, 0, 0};
    int middle[5] = {0, 1, 0, 0, 1};
    int back[7] = {0, 0, 1, 0, 0, 1, 0};

    // Array of pointers
    int *hall2[3] = {front, middle, back};

    int sizes[3] = {3, 5, 7};

    // Pointer to a row of Hall 1
    int (*rowPointer)[4] = hall1;

    printf("========== HALL 1 ==========\n");

    displayHall1(rowPointer, 3);

    printf("Vacant seats: %d\n",
           countVacantHall1(rowPointer, 3));

    printf("\n========== HALL 2 ==========\n");

    displayHall2(hall2, sizes, 3);

    printf("Vacant seats: %d\n",
           countVacantHall2(hall2, sizes, 3));

    // Book a seat
    bookSeat(hall2, sizes, 3);

    printf("\n========== UPDATED HALL 2 ==========\n");

    displayHall2(hall2, sizes, 3);

    printf("Vacant seats: %d\n",
           countVacantHall2(hall2, sizes, 3));

    return 0;
}

// Display Hall 1 using pointer to a row
void displayHall1(int (*ptr)[4], int rows)
{
    int i, j;

    for (i = 0; i < rows; i++)
    {
        printf("Row %d: ", i + 1);

        for (j = 0; j < 4; j++)
        {
            if (*(*(ptr + i) + j) == 0)
            {
                printf("V ");
            }
            else
            {
                printf("B ");
            }
        }

        printf("\n");
    }
}

// Count vacant seats in Hall 1
int countVacantHall1(int (*ptr)[4], int rows)
{
    int i, j;
    int count = 0;

    for (i = 0; i < rows; i++)
    {
        for (j = 0; j < 4; j++)
        {
            if (*(*(ptr + i) + j) == 0)
            {
                count++;
            }
        }
    }

    return count;
}

// Display Hall 2 using array of pointers
void displayHall2(int *hall[], int sizes[], int rows)
{
    int i, j;

    for (i = 0; i < rows; i++)
    {
        printf("Row %d: ", i + 1);

        for (j = 0; j < sizes[i]; j++)
        {
            if (*(*(hall + i) + j) == 0)
            {
                printf("V ");
            }
            else
            {
                printf("B ");
            }
        }

        printf("\n");
    }
}

// Count vacant seats in Hall 2
int countVacantHall2(int *hall[], int sizes[], int rows)
{
    int i, j;
    int count = 0;

    for (i = 0; i < rows; i++)
    {
        for (j = 0; j < sizes[i]; j++)
        {
            if (*(*(hall + i) + j) == 0)
            {
                count++;
            }
        }
    }

    return count;
}

// Book a seat in Hall 2
void bookSeat(int *hall[], int sizes[], int rows)
{
    int row, seat;

    printf("\nEnter row number (1-3): ");
    scanf("%d", &row);

    if (row < 1 || row > rows)
    {
        printf("Invalid row! This row does not exist.\n");
        return;
    }

    printf("Enter seat number (1-%d): ", sizes[row - 1]);
    scanf("%d", &seat);

    if (seat < 1 || seat > sizes[row - 1])
    {
        printf("Invalid seat! This seat does not exist in this row.\n");
        return;
    }

    if (*(*(hall + row - 1) + seat - 1) == 1)
    {
        printf("Booking failed! This seat is already booked.\n");
        return;
    }

    *(*(hall + row - 1) + seat - 1) = 1;

    printf("Seat booked successfully!\n");
}

